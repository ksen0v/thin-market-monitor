<Application x:Class="ThinMarketMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Surface" Color="#141C2A"/>
        <SolidColorBrush x:Key="Outline" Color="#34445A"/>
        <SolidColorBrush x:Key="Muted" Color="#9CADC4"/>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#0C121D"/>
            <Setter Property="Foreground" Value="#E7EDF7"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#16233A"/>
            <Setter Property="Background" Value="#DBE8F9"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E7EDF7"/>
        </Style>
    </Application.Resources>
</Application>
