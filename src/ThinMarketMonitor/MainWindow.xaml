<Window x:Class="ThinMarketMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thin Market Monitor" Width="1280" Height="850" MinWidth="820" MinHeight="650"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="125"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="GridTwo" Content="2 × 2" Click="ChangeGrid"/>
                <Button x:Name="GridThree" Content="3 × 3" Click="ChangeGrid"/>
                <Button Content="Настройки" Click="OpenSettings" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Thin Market Monitor" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,10,0,11" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Обновить каталоги" Click="RefreshCatalogs" Margin="10,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CatalogStatus" Text="Загрузка каталогов…" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StreamStatus" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>
        <UniformGrid x:Name="Charts" Grid.Row="2" Rows="2" Columns="2"/>
        <Border Grid.Row="3" Margin="3,8,3,0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Outline}" BorderThickness="1" Padding="10,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Журнал сигналов" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListBox x:Name="Journal" Background="Transparent" Foreground="#E7EDF7" BorderThickness="0"
                         AutomationProperties.Name="Журнал сигналов" MouseDoubleClick="OpenJournalMarket"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
