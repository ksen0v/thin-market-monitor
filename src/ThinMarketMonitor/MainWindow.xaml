<Window x:Class="ThinMarketMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thin Market Monitor" Width="1180" Height="720" MinWidth="690" MinHeight="470" Icon="Assets/terminal.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel x:Name="Workspace">
            <Border DockPanel.Dock="Top" Height="42" Padding="10,0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PriceAlertsButton" Click="OpenPriceAlerts" MinHeight="26" Margin="0,0,3,0"
                                AutomationProperties.Name="Ценовые оповещения"/>
                        <Button x:Name="PriceAlertColibriButton" Click="OpenLatestPriceAlert" Style="{StaticResource IconButton}"
                                MinHeight="26" Margin="0,0,4,0" Visibility="Collapsed"/>
                        <Button x:Name="SignalListingsButton" Click="OpenSignalListings" MinHeight="26" Margin="0,0,6,0"
                                AutomationProperties.Name="Листинги сигналов"/>
                        <Border x:Name="GridSwitch" Background="{StaticResource Plot}" BorderBrush="{StaticResource Outline}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" AutomationProperties.Name="Сетка графиков">
                                <ToggleButton x:Name="GridTwo" Style="{StaticResource GridButton}" Content="2 × 2" Click="ChangeGrid"/>
                                <ToggleButton x:Name="GridThree" Style="{StaticResource GridButton}" Content="3 × 3" Click="ChangeGrid" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BrandMark" Width="21" Height="21" Background="{StaticResource AccentSurface}" Margin="0,0,8,0"/>
                        <TextBlock Text="Thin Market Monitor" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border x:Name="IntegrationStatusHost" DockPanel.Dock="Bottom" Visibility="Collapsed" Padding="10,4"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="IntegrationStatus" TextTrimming="CharacterEllipsis" FontSize="11"/>
            </Border>
            <Grid Margin="10,5,10,10">
                <ContentControl x:Name="DensityHost" Visibility="Collapsed"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <DockPanel x:Name="GridSpace">
                    <ScrollViewer x:Name="ChartScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  SizeChanged="ResizeChartGrid" Background="{StaticResource Outline}" Padding="1,1,0,0">
                        <UniformGrid x:Name="Charts" Rows="2" Columns="2" AutomationProperties.Name="Свечные графики"/>
                    </ScrollViewer>
                </DockPanel>
                <DockPanel x:Name="OverviewSpace" Visibility="Collapsed">
                    <Border DockPanel.Dock="Right" Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}"
                            BorderThickness="1,0,0,0">
                        <Button x:Name="DrawerSwitch" Style="{StaticResource IconButton}" Width="28" Height="30"
                                VerticalAlignment="Top" Margin="1,7" Click="ChangeDrawer"/>
                    </Border>
                    <ContentControl x:Name="OverviewSourcesHost" DockPanel.Dock="Top" Margin="0,0,0,3"
                                    HorizontalContentAlignment="Stretch" AutomationProperties.Name="Биржи обзора"/>
                    <Grid x:Name="OverviewBody" SizeChanged="OverviewBodySizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="285"/>
                            <ColumnDefinition x:Name="OverviewDividerColumn" Width="10"/>
                            <ColumnDefinition x:Name="OverviewDrawerColumn" Width="0.55*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="OverviewChartHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                        <GridSplitter x:Name="OverviewDivider" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="OverviewDividerCompleted"
                                      ShowsPreview="True" KeyboardIncrement="16" DragIncrement="1" Cursor="SizeWE"
                                      AutomationProperties.Name="Ширина списка инструментов"
                                      ToolTip="Перетащите, чтобы изменить ширину списка инструментов"
                                      FocusVisualStyle="{StaticResource TerminalFocus}">
                            <GridSplitter.Template>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Grid Background="Transparent">
                                        <Border x:Name="Grip" Width="3" Height="36" CornerRadius="1.5" Background="{StaticResource Outline}"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </GridSplitter.Template>
                        </GridSplitter>
                        <ContentControl x:Name="OverviewDrawerHost" Grid.Column="2" HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
        <ContentControl x:Name="FullChart" Visibility="Collapsed" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <Grid x:Name="Overlay" Background="{StaticResource Shade}" Visibility="Collapsed" FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <ContentControl x:Name="DialogHost" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Focusable="False" IsTabStop="False"/>
        </Grid>
        <Border x:Name="BottomNavigation" Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}"
                BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="WorkspaceNavigation" Grid.Column="1" Background="{StaticResource Plot}" BorderBrush="{StaticResource Outline}"
                        BorderThickness="1" CornerRadius="10" Padding="3" AutomationProperties.Name="Рабочие области">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SignalsButton" Style="{StaticResource WorkspaceNavigationButton}" ToolTip="Сигналы"
                                AutomationProperties.Name="Сигналы" Click="ChangeWorkspace"/>
                        <Button x:Name="OverviewButton" Style="{StaticResource WorkspaceNavigationButton}" ToolTip="Обзор"
                                AutomationProperties.Name="Обзор" Click="ChangeWorkspace" Margin="3,0"/>
                        <Button x:Name="DensityButton" Style="{StaticResource WorkspaceNavigationButton}" ToolTip="Плотности"
                                AutomationProperties.Name="Плотности" Click="ChangeWorkspace" Margin="0,0,3,0"/>
                        <Button x:Name="SettingsButton" Style="{StaticResource WorkspaceNavigationButton}" ToolTip="Настройки"
                                AutomationProperties.Name="Настройки" Click="OpenSettings"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MonitorNotice" Visibility="Collapsed" Foreground="{StaticResource Muted}"
                               TextTrimming="CharacterEllipsis" FontSize="11"/>
                    <StackPanel x:Name="MonitorDiagnostics" Visibility="Collapsed">
                        <TextBlock x:Name="CatalogStatus" Text="Обновление каталогов…" TextTrimming="CharacterEllipsis" FontSize="11"/>
                        <DockPanel>
                            <Ellipse x:Name="StreamLed" DockPanel.Dock="Left" Width="6" Height="6" Fill="{StaticResource Muted}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StreamStatus" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
